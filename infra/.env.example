# anwar.os production environment.
# On the server: cp .env.example .env && chmod 600 .env, then fill in every value.
# Read by docker compose (compose.prod.yml), deploy.sh and the backup scripts.
# Keep a copy of the filled-in file in your password manager: it is NOT in the
# backups.
#
# Format: KEY=value, one per line, comments on their own lines, no `export`, no
# spaces around `=`. Generate secrets with the commands shown; hex values are
# URL-safe, which matters because the passwords are embedded in database URLs.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public hostname (apex). DNS A/AAAA records for it and www must point at the
# server before the first start, or Caddy can't get certificates.
# BETTER_AUTH_URL is derived from it as https://$DOMAIN, and deploy.sh renders
# the edge site file (infra/edge/sites/anwar-os.caddy.tmpl) with it.
# The Let's Encrypt email belongs to the shared edge: /opt/edge/.env.
DOMAIN=anwar-os.com

# Image tags. Managed by deploy.sh, which rewrites these lines with the deployed
# commit sha; "latest" is fine for the very first start.
# WEB_TAG covers web + migrate.
WEB_TAG=latest
BOT_EXPENSES_TAG=latest
BOT_OSBOT_TAG=latest
OPS_AGENT_TAG=latest

# Optional compose profiles. Set to "bots" once a bot is configured
# (BOT_EXPENSES_* and/or OSBOT_* below); empty = web stack only. deploy.sh
# only deploys the bots whose settings are filled in. Add "ops" for the control
# panel's agent once OPS_AGENT_SECRET is set (e.g. COMPOSE_PROFILES=bots,ops).
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Database (postgres:17 container, never exposed outside the internal network)
# ---------------------------------------------------------------------------

# Superuser password. Used by migrations (MIGRATION_DATABASE_URL), backups,
# restores and owner creation.
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Password of the os_app runtime role (no superuser, no BYPASSRLS), created by
# db/init/01-roles.sh on first start. The app connects with it (DATABASE_URL).
# openssl rand -hex 32
OS_APP_PASSWORD=

# Derived in compose.prod.yml, do not set here:
#   DATABASE_URL=postgres://os_app:$OS_APP_PASSWORD@db:5432/anwar_os
#   MIGRATION_DATABASE_URL=postgres://postgres:$POSTGRES_PASSWORD@db:5432/anwar_os
#   BETTER_AUTH_URL=https://$DOMAIN
#   NODE_ENV=production

# Changing POSTGRES_PASSWORD / OS_APP_PASSWORD after the first start does NOT
# update Postgres (init scripts only run on an empty volume). Rotate with
# ALTER ROLE ... PASSWORD first, then change it here.

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------

# Signs sessions and encrypts 2FA secrets. Rotating it signs everyone out.
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional "Sign in with Google": an OAuth client (Web application) from Google
# Cloud Console, redirect URI https://$DOMAIN/api/auth/callback/google
# (docs/DEPLOY.md, "Google sign-in"). Empty = no Google buttons anywhere. It
# only ever signs in a Google account you connected in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in rate limits (docs/DEPLOY.md, "Security headers and limits") are on in
# production. Only set this to switch them off for an emergency: off.
AUTH_RATE_LIMIT=

# ---------------------------------------------------------------------------
# Object storage (Hetzner Object Storage, S3-compatible)
# Used by the files module (phase 4) and, by default, by backups.
# ---------------------------------------------------------------------------

# https://<location>.your-objectstorage.com: fsn1 (Falkenstein), nbg1
# (Nuremberg), hel1 (Helsinki). Pick the server's location.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
# Bucket for app files (private).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Hetzner supports virtual-hosted-style URLs; leave false.
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Backups (infra/backup/backup.sh, run nightly by anwar-os-backup.timer)
# ---------------------------------------------------------------------------

# age PUBLIC key(s) the dumps are encrypted to, space-separated. Generate the
# pair on your laptop: `age-keygen -o anwar-os-backup.key` and paste the
# "Public key: age1..." line here. The private key never goes on the server.
BACKUP_AGE_RECIPIENT=

# Where encrypted dumps go: s3 (Object Storage, default), sftp (Hetzner Storage
# Box) or none (local copies only, for testing).
BACKUP_TARGET=s3

# Separate bucket for backups (recommended: a leaked app key then can't read
# or delete them, if you also give backups their own key below). Empty = use
# S3_BUCKET, with backups under BACKUP_PREFIX.
BACKUP_S3_BUCKET=
BACKUP_PREFIX=postgres

# Optional: separate credentials / endpoint for backups. Empty = the S3_* values.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=

# --- BACKUP_TARGET=sftp (Hetzner Storage Box, SSH on port 23)
# BACKUP_SFTP_HOST=uXXXXXX.your-storagebox.de
# BACKUP_SFTP_USER=uXXXXXX-sub1
# BACKUP_SFTP_PORT=23
# BACKUP_SFTP_KEY_FILE=/root/.ssh/storagebox

# Retention: newest N kept in daily/, weekly/, monthly/ on the remote.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Encrypted copies kept on the server itself (fast restore after a bad deploy).
BACKUP_LOCAL_DIR=/var/backups/anwar-os
BACKUP_LOCAL_KEEP=2

# Status of the last run (last.json, last-success.json; mode 644, no secrets),
# read by ops-agent for Ops → Server and osbot's backup alert. Mounted into
# ops-agent read-only (compose.prod.yml). Default /var/backups/anwar-os-status.
# BACKUP_STATUS_DIR=/var/backups/anwar-os-status

# Optional dead-man's switch, e.g. a healthchecks.io check URL. Pinged on
# success, URL/fail on failure; it alerts you when pings stop.
# docs/DEPLOY.md §19 (Monitoring) has the setup.
BACKUP_PING_URL=

# ---------------------------------------------------------------------------
# Expense bot (bots/expenses, compose profile "bots")
# ---------------------------------------------------------------------------

# The bot is a front-end for Budget: expenses are Budget transactions, written
# through web's signed internal API (/api/internal/budget-bot/*).

# Token from @BotFather. Only one process may poll a token: stop the old bot
# before enabling this one.
BOT_EXPENSES_TOKEN=

# Shared secret that signs the bot's calls to web's Budget API. Setting it turns
# that API on; empty = it answers 404 and deploy.sh doesn't start the bot.
# Separate from OSBOT_API_SECRET. openssl rand -hex 32
BOT_EXPENSES_API_SECRET=

# Your Telegram user id: the only person the bot serves (everything lands in the
# owner's Budget). Empty = OSBOT_OWNER_CHAT_ID (the same number for a private
# chat). docs/DEPLOY.md §14 step 2 shows how to find it.
BOT_EXPENSES_OWNER_ID=

# Password of the bot's old database role (schema bot_expenses). The running
# bot doesn't use it any more; only the one-time
# `python -m expenses_bot import-to-budget` reads the old rows with it. When
# set, deploy.sh keeps applying bots/expenses/db/bootstrap.sql (harmless).
# openssl rand -hex 24
BOT_EXPENSES_DB_PASSWORD=

# ---------------------------------------------------------------------------
# osbot: your own Telegram bot (bots/osbot, compose profile "bots")
# docs/DEPLOY.md, "Connect osbot".
# ---------------------------------------------------------------------------

# Token from @BotFather. web also uses it for direct feedback alerts while the
# bot container is down or not deployed.
OSBOT_TOKEN=

# Your chat id (a number): the only chat the bot ever answers, and where
# reminders and alerts go.
OSBOT_OWNER_CHAT_ID=

# Shared secret that signs the bot's calls to web's internal API. Setting it
# turns that API on; empty = the API answers 404 and only direct alerts work.
# openssl rand -hex 32
OSBOT_API_SECRET=

# ---------------------------------------------------------------------------
# Control panel: ops-agent (compose profile "ops", /app/ops and /app/bots)
# ---------------------------------------------------------------------------

# Shared secret web signs every ops-agent request with (HMAC-SHA256). At least
# 32 characters. openssl rand -hex 32
OPS_AGENT_SECRET=

# Where web reaches the agent. Set it together with the "ops" profile; leave it
# empty and the panel says "Control panel not connected".
# OPS_AGENT_URL=http://ops-agent:8080
OPS_AGENT_URL=

# GID of /var/run/docker.sock (`stat -c %g /var/run/docker.sock`). deploy.sh
# detects it; set it here only for hand-run `docker compose up`.
# DOCKER_GID=

# Seconds a deploy from the panel waits for the new container's healthcheck
# before rolling back. Default 240.
# OPS_AGENT_DEPLOY_TIMEOUT=240

# Only if the GHCR packages are private: a GitHub user + classic PAT with
# read:packages, so the agent can pull.
# Compose projects the panel can see; the first is primary (plain names).
# Add another project on this server, e.g. anwar-os,edge,shiftella.
# OPS_AGENT_PROJECTS=anwar-os,edge
# OPS_AGENT_REGISTRY_USER=
# OPS_AGENT_REGISTRY_TOKEN=

# Ops → Server reads the edge site files (which domains' certificates to
# check) from here, mounted read-only into ops-agent. Same default as the edge.
# EDGE_SITES_DIR=/opt/edge/sites

# Deploy dialog: lists image tags from GHCR and matches them to commits of
# GITHUB_REPO. Public packages and a public repo work without a token; a token
# (read:packages) adds private packages and a higher API rate limit.
# GITHUB_REPO=NnnotAnwar/anwar-os
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# AI: Claude (web only). docs/DEPLOY.md, "AI assistant (Claude)".
# ---------------------------------------------------------------------------

# Anthropic API key (console.anthropic.com → API keys). Switches on the AI
# assistant (/app/assistant) and receipt photos (Budget quick add, expense bot).
# Only web holds it; calls go from the server to api.anthropic.com, never from a
# browser or a bot. Empty = AI off: the assistant page says how to switch it on.
ANTHROPIC_API_KEY=

# Optional overrides (defaults in brackets):
# Chat model [claude-sonnet-5-5]. A chat keeps the model it started with.
# ASSISTANT_MODEL=claude-sonnet-5-5
# Thinking effort for chat: low | medium | high [low]. Higher = slower, dearer.
# ASSISTANT_EFFORT=low
# Output cap per reply, 1024-64000 [8192].
# ASSISTANT_MAX_TOKENS=8192
# Stop new chat turns once this month's estimated spend (chat + receipts, US $)
# reaches this. Empty = no cap. Settings shows the month's usage either way.
# ASSISTANT_MONTHLY_LIMIT_USD=10
# Model that reads receipt photos [claude-haiku-5-5]: cheap and fast; set
# claude-sonnet-5-5 if it misreads your receipts.
# RECEIPT_MODEL=claude-haiku-5-5
