# anwar.os production environment.
# On the server: cp .env.example .env && chmod 600 .env, then fill in every value.
# Read by docker compose (compose.prod.yml), deploy.sh and the backup scripts.
# Keep a copy of the filled-in file in your password manager: it is NOT in the
# backups.
#
# Format: KEY=value, one per line, comments on their own lines, no `export`, no
# spaces around `=`. Generate secrets with the commands shown; hex values are
# URL-safe, which matters because the passwords are embedded in database URLs.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public hostname (apex). DNS A/AAAA records for it and www must point at the
# server before the first start, or Caddy can't get certificates.
# BETTER_AUTH_URL is derived from it as https://$DOMAIN.
DOMAIN=anwarnnnot.com

# Contact address for Let's Encrypt (expiry warnings, account recovery).
ACME_EMAIL=you@example.com

# Image tags. Managed by deploy.sh, which rewrites these lines with the deployed
# commit sha; "latest" is fine for the very first start.
# WEB_TAG covers web + migrate.
WEB_TAG=latest
BOT_EXPENSES_TAG=latest

# Optional compose profiles. Set to "bots" once the expense bot is configured
# (BOT_EXPENSES_* below); empty = web stack only.
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Database (postgres:17 container, never exposed outside the internal network)
# ---------------------------------------------------------------------------

# Superuser password. Used by migrations (MIGRATION_DATABASE_URL), backups,
# restores and owner creation.
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Password of the os_app runtime role (no superuser, no BYPASSRLS), created by
# db/init/01-roles.sh on first start. The app connects with it (DATABASE_URL).
# openssl rand -hex 32
OS_APP_PASSWORD=

# Derived in compose.prod.yml, do not set here:
#   DATABASE_URL=postgres://os_app:$OS_APP_PASSWORD@db:5432/anwar_os
#   MIGRATION_DATABASE_URL=postgres://postgres:$POSTGRES_PASSWORD@db:5432/anwar_os
#   BETTER_AUTH_URL=https://$DOMAIN
#   NODE_ENV=production

# Changing POSTGRES_PASSWORD / OS_APP_PASSWORD after the first start does NOT
# update Postgres (init scripts only run on an empty volume). Rotate with
# ALTER ROLE ... PASSWORD first, then change it here.

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------

# Signs sessions and encrypts 2FA secrets. Rotating it signs everyone out.
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Object storage (Hetzner Object Storage, S3-compatible)
# Used by the files module (phase 4) and, by default, by backups.
# ---------------------------------------------------------------------------

# https://<location>.your-objectstorage.com: fsn1 (Falkenstein), nbg1
# (Nuremberg), hel1 (Helsinki). Pick the server's location.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
# Bucket for app files (private).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Hetzner supports virtual-hosted-style URLs; leave false.
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Backups (infra/backup/backup.sh, run nightly by anwar-os-backup.timer)
# ---------------------------------------------------------------------------

# age PUBLIC key(s) the dumps are encrypted to, space-separated. Generate the
# pair on your laptop: `age-keygen -o anwar-os-backup.key` and paste the
# "Public key: age1..." line here. The private key never goes on the server.
BACKUP_AGE_RECIPIENT=

# Where encrypted dumps go: s3 (Object Storage, default), sftp (Hetzner Storage
# Box) or none (local copies only, for testing).
BACKUP_TARGET=s3

# Separate bucket for backups (recommended: a leaked app key then can't read
# or delete them, if you also give backups their own key below). Empty = use
# S3_BUCKET, with backups under BACKUP_PREFIX.
BACKUP_S3_BUCKET=
BACKUP_PREFIX=postgres

# Optional: separate credentials / endpoint for backups. Empty = the S3_* values.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=

# --- BACKUP_TARGET=sftp (Hetzner Storage Box, SSH on port 23)
# BACKUP_SFTP_HOST=uXXXXXX.your-storagebox.de
# BACKUP_SFTP_USER=uXXXXXX-sub1
# BACKUP_SFTP_PORT=23
# BACKUP_SFTP_KEY_FILE=/root/.ssh/storagebox

# Retention: newest N kept in daily/, weekly/, monthly/ on the remote.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Encrypted copies kept on the server itself (fast restore after a bad deploy).
BACKUP_LOCAL_DIR=/var/backups/anwar-os
BACKUP_LOCAL_KEEP=2

# Optional dead-man's switch, e.g. a healthchecks.io check URL. Pinged on
# success, URL/fail on failure; it alerts you when pings stop.
BACKUP_PING_URL=

# ---------------------------------------------------------------------------
# Expense bot (bots/expenses, compose profile "bots")
# ---------------------------------------------------------------------------

# Token from @BotFather. Only one process may poll a token: stop the old bot
# before enabling this one.
BOT_EXPENSES_TOKEN=

# Password of the bot_expenses role. deploy.sh applies it through
# bots/expenses/db/bootstrap.sql before each bot start.
# openssl rand -hex 24
BOT_EXPENSES_DB_PASSWORD=

# ---------------------------------------------------------------------------
# osbot: Telegram alerts to you (optional)
# ---------------------------------------------------------------------------

# New feedback from /feedback is sent to this chat through the Bot API. Leave
# both empty to turn alerts off; submissions work either way. Token from
# @BotFather (osbot); chat id: message the bot, then open
# https://api.telegram.org/bot<token>/getUpdates and read message.chat.id.
# OSBOT_TOKEN=
# OSBOT_OWNER_CHAT_ID=

# ---------------------------------------------------------------------------
# Later phases (leave commented until the feature exists)
# ---------------------------------------------------------------------------

# Phase 5, ops-agent: shared secret web uses to sign requests. openssl rand -hex 32
# OPS_AGENT_HMAC_SECRET=
