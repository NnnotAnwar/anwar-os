# anwar.os edge. DOMAIN (anwar-os.com) and ACME_EMAIL come from infra/.env
# via compose.
# Caddy gets and renews the Let's Encrypt certificate on its own once DNS points
# here and ports 80/443 are open. Reload after editing:
#   docker compose -f compose.prod.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		# HTTPS only for a year. Add "; preload" and submit to hstspreload.org
		# only once you're sure every subdomain will always have TLS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By

		# Content-Security-Policy: deliberately NOT set here. It needs a fresh
		# nonce per response, so the app sets it: src/proxy.ts (pages) and
		# next.config.ts (sw.js, offline.html). A second CSP from Caddy would be
		# combined with it (browsers enforce both), so don't add one.
		# Overview of who sets what: docs/DEPLOY.md, "Security headers".
	}
}

{$DOMAIN} {
	import security_headers

	# zstd/gzip for text responses. Streaming (Suspense / PPR) still works:
	# responses without Content-Length are flushed as they arrive.
	encode zstd gzip

	# The osbot API is for the bot inside the stack (it calls http://web:3000
	# directly). It is HMAC-signed anyway; this keeps it off the internet too.
	respond /api/internal/* 404

	reverse_proxy web:3000 {
		# Next drains in-flight requests on SIGTERM; give Caddy a few retries
		# while a container is being recreated during a deploy.
		lb_try_duration 10s
		lb_try_interval 250ms
	}

	log {
		output stdout
		format json
	}
}

# www -> apex. Needs the www A/AAAA records (docs/DEPLOY.md, "DNS"); without
# them Caddy keeps retrying the www certificate (the apex is unaffected).
www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}
