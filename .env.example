# Copy to .env.local for development. Values below match compose.yaml defaults.

# Postgres (compose.yaml). The app connects as os_app, which cannot bypass RLS;
# migrations and scripts/create-owner.mts use the superuser.
POSTGRES_PASSWORD=postgres
OS_APP_PASSWORD=os_app
DATABASE_URL=postgres://os_app:os_app@127.0.0.1:55432/anwar_os
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/anwar_os

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Passkeys use this URL's hostname as their relying party ID, and browsers
# refuse IP addresses there: use localhost (or <name>.localhost, which also
# keeps cookies apart from other local apps), not 127.0.0.1.
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Sign in with Google" (docs/DEPLOY.md, "Google sign-in"). Leave
# empty to hide every Google button. For local testing the OAuth client needs
# the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for the files module (S3 API). Defaults match compose.yaml's
# s3 service; in production point these at Hetzner Object Storage, e.g.
# S3_ENDPOINT=https://fsn1.your-objectstorage.com, S3_REGION=fsn1,
# S3_FORCE_PATH_STYLE=false. Browsers upload straight to this endpoint, so it
# must be reachable from them, and the bucket needs CORS: `pnpm s3:setup`
# (origin from BETTER_AUTH_URL, or S3_CORS_ORIGINS=https://a,https://b).
# Leave S3_* empty to run without uploads (documents and folders still work).
S3_ENDPOINT=http://127.0.0.1:55434
S3_REGION=us-east-1
S3_BUCKET=anwar-os-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey123
S3_FORCE_PATH_STYLE=true

# Optional: osbot (bots/osbot). OSBOT_API_SECRET (32+ chars, openssl rand -hex 32)
# turns on the signed /api/internal/osbot/* API the bot calls; token + chat id
# send feedback alerts directly while the bot isn't running. Empty = off.
# Never put the production bot token in a dev environment.
OSBOT_API_SECRET=
OSBOT_TOKEN=
OSBOT_OWNER_CHAT_ID=
